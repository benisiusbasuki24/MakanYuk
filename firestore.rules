rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Menu items are publicly readable and editable for demo/admin
    match /menu/{menuId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Orders can be created by authenticated customers and read/updated
    match /orders/{orderId} {
      allow read, create, update, delete: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read, write, create, update: if true;
    }
  }
}
